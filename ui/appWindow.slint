import { Button } from "std-widgets.slint";

export component AppWindow inherits Window {
    width: 600px;
    height: 400px;
    title: "personal Smart Hub";

    // properties available in c++
    in property <string> db-status: "Disconnected";
    in property <int> mHR: 0;
    in property <int> rHR: 0;
    in property <int> avgStress: 0;
    in property <int> bodyBattery: 0;
    in property <string> garmin-status: "Not fetched";

    callback fetch-Garmin();

    VerticalLayout {
        padding: 20px;
        spacing: 15px;

        Text {
            text: "Personal API Database demo";
            font-size: 24px;
            font-weight: 700;
        }

        Text {
            text: "Database status: " + root.db-status;
            font-size: 16px;
        }

        Text {
            text: "Garmin status: " + root.garmin-status;
            font-size: 16px;
        }

        Text{
            text: "Resting Heart Rate: " + root.rHR + " bpm";
            font-size: 16px;
        }

        Text {
            text: "Maximum Heart Rate: " + root.mHR + " bpm";
            font-size: 16px;
        }

        Text {
            text: "Average Stress: " + root.avgStress;
            font-size: 16px;
        }

        Text {
            text: "Body Battery: " + root.bodyBattery;
            font-size: 16px;
        }

        Button {
            text: "Fetch GarminData";
            clicked => {
                root.fetch-Garmin();
            }
        }
    }
}