import { Button } from "std-widgets.slint";

export component AppWindow inherits Window {
    width: 600px;
    height: 400px;
    title: "personal Smart Hub";

    in property <string> db-status: "Disconnected";
    callback get_garmin();

    VerticalLayout {
        padding: 20px;
        spacing: 15px;

        Text {
            text: "Personal API Database demo";
            font-size: 24px;
            font-weight: 700;
        }

        Text {
            text: "Database status: " + root.db-status;
            font-size: 16px;
        }

        Text{
            text: "Resting Heart Rate: " + root.rHR + " bpm";
            font-size: 16px;
            font-weight: bold;
        }

        Text {
            text: "Maximum Heart Rate :" + root.mHR + " bpm";
            font-size: 16px;
            font-weight: bold;
        }

        Button {
            text: "Fetch GarminData";
            clicked => {
                root.get_garmin();
            }
        }
    }
}